# Arif Signal Bot Configuration
# =============================

# Telegram Configuration
TELEGRAM_TOKEN=ISI_TOKEN_KAMU
TELEGRAM_CHAT_ID=ISI_CHAT_ID_KAMU

# Dual Mode Configuration
# Separate chat IDs for different modes (optional)
SCALPING_CHAT_ID=ISI_CHAT_ID_KAMU
SWING_CHAT_ID=ISI_CHAT_ID_KAMU

# Trading Configuration
TIMEFRAME=15m
MIN_VOLUME_USDT=200000
SIGNAL_COOLDOWN_MINUTES=15
LOG_LEVEL=INFO

# Dual Mode Settings
# Both modes will run simultaneously
# Scalping: 15m timeframe, faster signals, lower thresholds, session-restricted
# Swing: 1h timeframe, slower signals, higher thresholds, runs 24/7